# 薪火 xinhuo 配置示例 —— 复制为 .env 并按需修改。
# 请勿把真实密钥提交到版本库。

# ---------------------------------------------------------------------------
# 模型端点(OpenAI 兼容:需支持 /embeddings、/rerank、/chat/completions)
# ---------------------------------------------------------------------------
# 只填占位域名,换成你自己的推理服务地址。
MODEL_API_BASE=https://your-model-endpoint.example/v1
MEMORY_MODEL_BASE_URL=https://your-model-endpoint.example/v1
MEMORY_MODEL_API_KEY=replace-with-your-key

# 模型名称(默认值为公开可用的开源模型,可自由替换)
MEMORY_EMBED_MODEL=BAAI/bge-m3
MEMORY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
MEMORY_WORKER_MODEL=deepseek-ai/DeepSeek-V3.2
MEMORY_JUDGE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# ---------------------------------------------------------------------------
# 存储路径(默认相对当前目录,便于本地试跑;生产环境请指向持久卷)
# ---------------------------------------------------------------------------
MEMORY_DB=./data/memory.sqlite3
MEMORY_ARCHIVE_DIR=./data/archive
MEMORY_ROOT=./data
MEMORY_STATE_DIR=./data
READING_MEMORY_ROOT=./data/reading
MEMORY_NAMESPACE=default

# ---------------------------------------------------------------------------
# HTTP / MCP 服务
# ---------------------------------------------------------------------------
MEMORY_HOST=127.0.0.1
MEMORY_PORT=18200
# 留空表示不校验(仅限本机可信环境);对外暴露时务必设置强随机令牌。
MEMORY_TOKEN=
AFFECT_WAKE_TOKEN=
MEMORY_CONTINUITY_REVIEW_TOKEN=

# ---------------------------------------------------------------------------
# 后台整理 Worker
# ---------------------------------------------------------------------------
MEMORY_WORKER_MODE=scheduler
MEMORY_WORKER_LANE=

# ---------------------------------------------------------------------------
# 可选:Qdrant 派生向量索引(SQLite 仍是唯一真源)
# ---------------------------------------------------------------------------
# 留空即禁用向量索引,系统会退回全文检索。
MEMORY_VECTOR_URL=
MEMORY_VECTOR_COLLECTION=xinhuo_memories
MEMORY_VECTOR_API_KEY=
MEMORY_VECTOR_SYNC_MAX_ROWS=4096
