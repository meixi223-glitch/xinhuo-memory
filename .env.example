# 复制为 .env。Token 至少 24 字符；禁止提交真实 .env。
# 或运行 python3 scripts/init.py --compose 自动生成 Docker 配置。
MEMORY_TOKEN=
MEMORY_STATE_DIR=./data
MEMORY_HOST=127.0.0.1
MEMORY_PORT=18200
XINHUO_PORT=18200
AFFECT_INTAKE_MODE=self_report
# 经 HTTPS 反向代理部署时设为 1。
XINHUO_SECURE_COOKIE=0

# 记忆主人与 AI 伙伴的称谓（叙述口径用，非原文证据）。默认中性占位；
# 每个部署改成自己的称呼。OWNER_PRONOUN 只填单字第三人称代词（她／他，
# 其它值按不限性别处理）。修改后重启服务生效。
OWNER_NAME=主人
COMPANION_NAME=小星
OWNER_PRONOUN=她

# 工作模型推荐在网页「设置」中填写。以下是可选的环境变量回退。
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_API_KEY=
MEMORY_EMBED_MODEL=BAAI/bge-m3
MEMORY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
MEMORY_WORKER_MODEL=deepseek-ai/DeepSeek-V3.2
MEMORY_JUDGE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# 可选的限定用途令牌和 Qdrant 派生索引。
AFFECT_WAKE_TOKEN=
MEMORY_CONTINUITY_REVIEW_TOKEN=
MEMORY_VECTOR_URL=
MEMORY_VECTOR_COLLECTION=xinhuo_memories
MEMORY_VECTOR_API_KEY=
